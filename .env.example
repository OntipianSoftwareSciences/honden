PORT=3000
CLIENT_ORIGIN=http://localhost:5173,tauri://localhost,http://tauri.localhost

DATABASE_URL=postgres://honden:honden_local_only@localhost:5432/honden
POSTGRES_USER=honden
POSTGRES_PASSWORD=honden_local_only
POSTGRES_DB=honden

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# Generate locally with `npm run vapid:keys`. Keep the private key server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_GIPHY_API_KEY=

# Optional TURN override for WebRTC calls. Defaults use OpenRelay's current static-auth host.
# VITE_TURN_URLS=turn:staticauth.openrelay.metered.ca:80,turn:staticauth.openrelay.metered.ca:443
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_CREDENTIAL=your-turn-credential
