{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HonDen",
  "version": "0.1.0",
  "identifier": "com.honden.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HonDen",
        "width": 900,
        "height": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "notification": {
      "iconColor": "#FF6B9D"
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": ["honden"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "android": {
      "minSdkVersion": 29
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
